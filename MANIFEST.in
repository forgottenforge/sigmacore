include README.md
include LICENSE.txt
include license_AGPL.txt
include license_COMMERCIAL.txt
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include SECURITY.md
include THEOREM_MAP.md
include RELEASE_NOTES.md
include DOCUMENTATION.md
include pyproject.toml
recursive-include sigma_c_core/include *
recursive-include sigma_c_core/src *
recursive-include sigma_c_v4 *.py *.md
recursive-include sigma_c *.py
recursive-include docs *.md
recursive-include scripts *.sh *.ps1
prune new
prune cache
prune cache_seis
prune era5_cache
prune dist
prune build
prune .venv
prune .claude
prune .vscode
prune .idea
prune .pytest_cache
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *.pyd
global-exclude *.dll
global-exclude .DS_Store
